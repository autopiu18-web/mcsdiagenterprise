{
  "name": "mcs-desktop",
  "version": "1.0.0",
  "description": "MCS - Diagnostics Enterprise Desktop Application",
  "author": "MCS Team",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "pnpm build && electron . --dev",
    "start": "concurrently \"pnpm dev\" \"sleep 2 && pnpm electron\"",
    "dist": "pnpm build && electron-builder --win nsis",
    "dist:portable": "pnpm build && electron-builder --win portable",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^10.16.0",
    "pdfkit": "^0.13.0",
    "ws": "^8.14.2",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/pdfkit": "^0.13.5",
    "@types/ws": "^8.5.5",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.1.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "ts-node": "^10.9.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "concurrently": "^8.2.0",
    "rimraf": "^5.0.0"
  },
  "build": {
    "appId": "com.mcs.diagnostics",
    "productName": "MCS - DIAGNOSTICS",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MCS - DIAGNOSTICS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
